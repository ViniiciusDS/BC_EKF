+"""Regressão do modo odometria 2WD 2026, sem dependência de Pygame."""
+from __future__ import annotations
+
+import csv
+import math
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+from src.odometry.pcntlog_adapter import Robot2026Profile
+from src.ui.algo_modes.dataset_odometry_pipeline import (
+    ROBOT2026_PROFILE,
+    load_robot2026_odometry,
+    list_robot2026_sources,
+    resolve_robot2026_source,
+)
+
+
+class TestDatasetOdometry2026(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        (self.root / "raw").mkdir()
+        (self.root / "processed").mkdir()
+
+    def _write(self, directory, filename, text):
+        p = self.root / directory / filename
+        p.write_text(text, encoding="utf-8")
+        return p
+
+    def test_default_4560_cpr_and_no_decimation(self):
+        # Uma volta completa em linha reta por duas rodas.
+        p = self._write("raw", "pcntLog.csv", "100,0,0,0,0\n350,2280,-2280,0,0\n600,4560,-4560,0,0\n")
+        data = load_robot2026_odometry(p)
+        self.assertEqual(ROBOT2026_PROFILE.ticks_per_wheel_rev, 4560)
+        self.assertEqual(data.sample_count, 3)
+        self.assertAlmostEqual(data.duration_s, 0.5)
+        self.assertAlmostEqual(data.poses_xytheta[-1, 0], 2 * math.pi * .03425, places=8)
+        self.assertAlmostEqual(data.poses_xytheta[-1, 1], 0., places=8)
+        self.assertAlmostEqual(data.poses_xytheta[-1, 2], 0., places=8)
+
+    def test_preserves_raw_sessions_and_selection(self):
+        p = self._write("raw", "pcntLog.csv", "100,0,0,0,0\n350,4560,-4560,1,0\n100,0,0,0,0\n350,2280,-2280,1,0\n")
+        data = load_robot2026_odometry(p, session_id=2)
+        self.assertEqual(data.total_sessions, 2)
+        self.assertEqual(data.session_id, 2)
+        self.assertEqual(data.sample_count, 2)
+        self.assertAlmostEqual(data.poses_xytheta[-1, 0], math.pi * .03425, places=8)
+        with self.assertRaisesRegex(ValueError, "Sessão 3 inexistente"):
+            load_robot2026_odometry(p, session_id=3)
+
+    def test_converted_encoder_already_sign_corrected(self):
+        # Saída do adapter: right_ticks POSITIVO; não pode inverter 2x.
+        p = self._write("processed", "robot2026_session_02_encoder.csv", "timestamp,left_ticks,right_ticks\n0,0,0\n250,4560,4560\n")
+        data = load_robot2026_odometry(p)
+        self.assertEqual(data.session_id, 2)
+        self.assertAlmostEqual(data.poses_xytheta[-1, 0], 2 * math.pi * .03425, places=8)
+        self.assertAlmostEqual(data.poses_xytheta[-1, 2], 0.0, places=8)
+
+    def test_converted_odometry_recomputed_not_stale(self):
+        # Os x_m do CSV foram gerados com outro CPR; devem ser ignorados.
+        p = self._write("processed", "robot2026_session_02_odometry.csv", "timestamp_ms,left_ticks,right_ticks,x_m,y_m,theta_rad\n0,0,0,0,0,0\n250,4560,4560,999,999,999\n")
+        data = load_robot2026_odometry(p)
+        self.assertAlmostEqual(data.poses_xytheta[-1, 0], 2 * math.pi * .03425, places=8)
+        self.assertLess(data.poses_xytheta[-1, 0], 1)
+
+    def test_sources_and_resolution(self):
+        self._write("raw", "pcntLog.csv", "0,0,0,0,0\n250,1,-1,0,0\n")
+        self._write("processed", "robot2026_session_01_encoder.csv", "timestamp,left_ticks,right_ticks\n0,0,0\n250,1,1\n")
+        self._write("processed", "other.txt", "not odometry")
+        options = list_robot2026_sources(self.root / "raw", self.root / "processed")
+        self.assertEqual(len(options), 2)
+        self.assertIn("Bruto: pcntLog.csv", options)
+        self.assertEqual(resolve_robot2026_source(options[0], self.root / 'raw', self.root / 'processed').suffix, '.csv')
+        with self.assertRaises(ValueError):
+            resolve_robot2026_source('Bruto: ../escape.csv', self.root / 'raw', self.root / 'processed')
+
+    def test_non_monotonic_converted_encoder_rejected(self):
+        p = self._write("processed", "robot2026_session_02_encoder.csv", "timestamp,left_ticks,right_ticks\n0,0,0\n0,5,5\n")
+        with self.assertRaisesRegex(ValueError, "Timestamp não crescente"):
+            load_robot2026_odometry(p)
+
+
+if __name__ == "__main__":
+    unittest.main()
