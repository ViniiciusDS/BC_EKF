diff --git a/src/ui/algo_modes/dataset_odometry_pipeline.py b/src/ui/algo_modes/dataset_odometry_pipeline.py
new file mode 100644
--- /dev/null
+++ b/src/ui/algo_modes/dataset_odometry_pipeline.py
@@ -0,0 +1,169 @@
+"""Importação de odometria real do carrinho 2WD 2026 para o Dataset Mode.
+
+Este módulo NÃO depende de Pygame ou UWB. Os CSVs de odometria do conversor
+antigo não são usados como verdade: recalculamos a trajetória a partir dos
+ticks, com o perfil selecionado (padrão experimental de 4560 CPR).
+"""
+from __future__ import annotations
+
+import csv
+from dataclasses import dataclass, field
+from pathlib import Path
+import re
+
+import numpy as np
+
+from src.odometry.pcntlog_adapter import (
+    RawPcntRow,
+    Robot2026Profile,
+    convert_session,
+    load_pcnt_sessions,
+)
+
+ROBOT2026_PROFILE = Robot2026Profile(
+    wheel_radius_m=0.03425,
+    wheel_base_m=0.229,
+    ticks_per_wheel_rev=4560.0,
+    invert_left=False,
+    invert_right=True,
+)
+
+RAW_PREFIX = "Bruto: "
+PROCESSED_PREFIX = "Processado: "
+
+
+@dataclass(frozen=True)
+class Odometry2026Data:
+    path: Path
+    session_id: int
+    total_sessions: int
+    timestamps_s: np.ndarray
+    poses_xytheta: np.ndarray
+    v_m_s: np.ndarray
+    omega_rad_s: np.ndarray
+    laps: np.ndarray
+    profile: Robot2026Profile = field(default_factory=lambda: ROBOT2026_PROFILE)
+
+    @property
+    def sample_count(self) -> int:
+        return len(self.timestamps_s)
+
+    @property
+    def duration_s(self) -> float:
+        return float(self.timestamps_s[-1] - self.timestamps_s[0]) if self.sample_count else 0.0
+
+
+def list_robot2026_sources(raw_dir: str | Path, processed_dir: str | Path) -> list[str]:
+    """Lista apenas formatos que o pipeline sabe converter, sem duplicatas."""
+    options: list[str] = []
+    raw = Path(raw_dir)
+    processed = Path(processed_dir)
+    if raw.is_dir():
+        options += [RAW_PREFIX + p.name for p in sorted(raw.iterdir(), key=lambda p: p.name.lower())
+                    if p.is_file() and p.suffix.lower() in {".csv", ".txt"}
+                    and "pcnt" in p.name.lower()]
+    if processed.is_dir():
+        options += [PROCESSED_PREFIX + p.name for p in sorted(processed.iterdir(), key=lambda p: p.name.lower())
+                    if p.is_file() and p.name.lower().endswith(("_encoder.csv", "_odometry.csv"))]
+    return options
+
+
+def resolve_robot2026_source(
+    selection: str, raw_dir: str | Path, processed_dir: str | Path
+) -> Path:
+    """Converte escolha do dropdown em caminho, sem aceitar traversal/nomes ambíguos."""
+    selection = str(selection).strip()
+    if selection.startswith(RAW_PREFIX):
+        directory = Path(raw_dir)
+        filename = selection[len(RAW_PREFIX):]
+    elif selection.startswith(PROCESSED_PREFIX):
+        directory = Path(processed_dir)
+        filename = selection[len(PROCESSED_PREFIX):]
+    else:
+        raise ValueError("Selecione uma opção 'Bruto:' ou 'Processado:' do dropdown")
+    if not filename or Path(filename).name != filename or filename in {".", ".."}:
+        raise ValueError("Nome de arquivo inválido")
+    path = directory / filename
+    if not path.is_file():
+        raise FileNotFoundError(f"Arquivo de odometria não encontrado: {path}")
+    return path
+
+
+def _read_converted_encoder(path: Path, invert_right: bool = True) -> list[RawPcntRow]:
+    """Reconstrói linhas RAW a partir dos ticks já orientados pelo conversor.
+
+    No CSV exportado, right_ticks JÁ foi invertido. Desfazemos a inversão
+    somente na entrada para reutilizar convert_session sem aplicá-la duas vezes.
+    """
+    rows: list[RawPcntRow] = []
+    with path.open("r", encoding="utf-8-sig", newline="") as f:
+        reader = csv.DictReader(f)
+        columns = set(reader.fieldnames or [])
+        if not {"left_ticks", "right_ticks"} <= columns:
+            raise ValueError("CSV convertido precisa conter left_ticks e right_ticks")
+        if not ({"timestamp_ms", "timestamp_s", "timestamp"} & columns):
+            raise ValueError("CSV convertido precisa conter timestamp_ms, timestamp_s ou timestamp")
+        for i, row in enumerate(reader, 2):
+            try:
+                if "timestamp_ms" in columns:
+                    time_ms = round(float(row["timestamp_ms"]))
+                elif "timestamp_s" in columns:
+                    time_ms = round(float(row["timestamp_s"]) * 1000)
+                else:
+                    # No _encoder.csv gerado pelo nosso adaptador, timestamp é ms.
+                    time_ms = round(float(row["timestamp"]))
+                l_corrected = int(float(row["left_ticks"]))
+                r_corrected = int(float(row["right_ticks"]))
+                laps = int(float(row.get("lap_count") or 0))
+            except (ValueError, TypeError) as exc:
+                raise ValueError(f"Linha {i}: dados de encoder inválidos") from exc
+            rows.append(RawPcntRow(time_ms, l_corrected, -r_corrected if invert_right else r_corrected, laps, 0))
+    if not rows:
+        raise ValueError("CSV de encoder vazio")
+    if any(b.timestamp_ms <= a.timestamp_ms for a, b in zip(rows, rows[1:])):
+        raise ValueError("Timestamp não crescente: separe sessões antes de importar")
+    return rows
+
+
+def load_robot2026_odometry(
+    path: str | Path, session_id: int = 1,
+    profile: Robot2026Profile | None = None,
+) -> Odometry2026Data:
+    """Carrega um pcntLog bruto ou uma sessão convertida, sem decimar dados.
+
+    Para o bruto, `session_id` é 1-based. Para um CSV de sessão já processada,
+    o número é extraído do nome e o seletor é ignorado.
+    """
+    path = Path(path)
+    if not path.is_file():
+        raise FileNotFoundError(path)
+    cfg = profile or ROBOT2026_PROFILE
+    cfg.validate()
+    with path.open("r", encoding="utf-8-sig", newline="") as f:
+        first = next(csv.reader(f), [])
+    numeric_start = False
+    if len(first) in (5, 20):
+        try:
+            numeric_start = all(np.isfinite(float(c.strip())) for c in first[:5])
+        except (ValueError, TypeError):
+            pass
+    if numeric_start:
+        sessions = load_pcnt_sessions(path)
+        if session_id < 1 or session_id > len(sessions):
+            raise ValueError(f"Sessão {session_id} inexistente; disponíveis 1..{len(sessions)}")
+        rows = sessions[session_id - 1]
+        n_sessions = len(sessions)
+        used_session = session_id
+    else:
+        rows = _read_converted_encoder(path, invert_right=cfg.invert_right)
+        match = re.search(r"session_(\d+)", path.stem, flags=re.I)
+        used_session = int(match.group(1)) if match else 1
+        n_sessions = 1
+
+    samples = convert_session(rows, cfg)
+    timestamps = np.array([r["timestamp_s"] for r in samples], dtype=float)
+    poses = np.array([[r["x_m"], r["y_m"], r["theta_rad"]] for r in samples], dtype=float)
+    v = np.array([r["v_m_s"] for r in samples], dtype=float)
+    omega = np.array([r["omega_rad_s"] for r in samples], dtype=float)
+    laps = np.array([r["lap_count"] for r in samples], dtype=int)
+    return Odometry2026Data(path, used_session, n_sessions, timestamps, poses, v, omega, laps, cfg)
